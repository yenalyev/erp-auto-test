# ERP autotest — dev environment secrets
# Copy to .env.dev and fill in values (file is gitignored).
#
# Loaded automatically when running: mvn test -Denv=dev ...
# Same variable names as whatsapp-bot / delivery-bot (.env).

CLIENT_ID=inventory-bot
# CLIENT_SECRET must match GET_TOKEN_URL realm (dev ≠ prod secret from whatsapp-bot .env)
CLIENT_SECRET=

GET_TOKEN_URL=https://auth.dev.faita.army/realms/cukerochka/protocol/openid-connect/token
GET_DATA_URL=https://dev.cukerochka.sbs/server/api/v1/internal/storages
GET_RELOCATIONS_DATA_URL=https://dev.cukerochka.sbs/server/api/v1/internal/relocations
GET_STRUCTURE_DATA_URL=https://dev.cukerochka.sbs/server/api/v1/internal/storages/structure
# GRANT_TYPE=client_credentials
