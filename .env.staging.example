# ERP autotest — staging environment secrets
# Copy to .env.staging and fill in values (file is gitignored).
#
# Loaded automatically when running: mvn test -Denv=staging ...
# Alias: -Denv=stage also reads .env.staging

CLIENT_ID=inventory-bot
CLIENT_SECRET=

GET_TOKEN_URL=https://auth.faita.army/realms/cukerochka/protocol/openid-connect/token
GET_DATA_URL=https://stage.cukerochka.sbs/server/api/v1/internal/storages
GET_RELOCATIONS_DATA_URL=https://stage.cukerochka.sbs/server/api/v1/internal/relocations
GET_STRUCTURE_DATA_URL=https://stage.cukerochka.sbs/server/api/v1/internal/storages/structure
# GRANT_TYPE=client_credentials

# Optional: override staging.properties use.database (true|false). Requires VPN to JDBC host.
# USE_DATABASE=false

# TCM reporting defaults to production https://tcm.lab from staging.properties.
# For local TCM use: TCM_BASE_URL=http://localhost:18100
# TCM_API_TOKEN=
