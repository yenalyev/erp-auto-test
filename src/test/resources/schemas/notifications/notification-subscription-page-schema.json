{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NotificationSubscriptionPage",
  "type": "object",
  "required": ["content"],
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recipientId", "templateCode"],
        "properties": {
          "recipientId": { "type": "integer" },
          "recipientName": { "type": ["string", "null"] },
          "templateCode": { "type": "string" },
          "templateDescription": { "type": ["string", "null"] },
          "storages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": ["integer", "null"] },
                "name": { "type": ["string", "null"] }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
