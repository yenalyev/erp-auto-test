{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StoragePagedResponse",
  "type": "object",
  "required": ["content"],
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "$ref": "storage-response-schema.json"
      }
    },
    "page": {
      "type": "object",
      "properties": {
        "size": { "type": "integer" },
        "number": { "type": "integer" },
        "totalElements": { "type": "integer" },
        "totalPages": { "type": "integer" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
