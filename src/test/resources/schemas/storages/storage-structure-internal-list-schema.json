{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StorageStructureInternalList",
  "description": "Schema for GET /api/v1/internal/storages/structure — flat {id, name, parentId}",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name"],
    "additionalProperties": true,
    "properties": {
      "id": { "type": "integer" },
      "name": { "type": "string" },
      "parentId": { "type": ["integer", "null"] }
    }
  }
}
