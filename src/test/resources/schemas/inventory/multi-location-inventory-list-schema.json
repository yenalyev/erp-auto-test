{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MultiLocationInventoryPagedResponse",
  "type": "object",
  "required": ["content"],
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource", "locations"],
        "properties": {
          "resource": { "type": "object" },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "storage": { "type": "object" },
                "amount": { "type": "number" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "page": { "type": "object" }
  },
  "additionalProperties": true
}
