{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StorageItemBatchList",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "integer" },
      "amount": { "type": "number" },
      "date": { "type": ["string", "null"], "format": "date-time" },
      "batchNumber": { "type": ["string", "null"] },
      "isProduced": { "type": "boolean" },
      "techmap": {
        "type": ["object", "null"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        },
        "required": ["id", "name"],
        "additionalProperties": true
      },
      "storage": {
        "type": ["object", "null"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        },
        "required": ["id", "name"],
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  }
}
