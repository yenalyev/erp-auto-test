{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RelocationResponse",
  "description": "Matches backend org.pm.tk.dto.response.RelocationResponse",
  "type": "object",
  "properties": {
    "id": { "type": "integer" },
    "type": { "type": "string", "enum": ["RESOURCE", "EQUIPMENT"] },
    "state": {
      "type": "string",
      "enum": ["CREATED", "AUTO_FINISHED", "FINISHED", "CANCELLED", "RETURNED", "LOST"]
    },
    "description": { "type": ["string", "null"] },
    "invoiceNumber": { "type": ["string", "null"] },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/relocationItem" }
    },
    "equipmentItems": {
      "type": "array",
      "items": { "type": "object" }
    },
    "sender": { "$ref": "#/definitions/simpleEntity" },
    "recipient": { "$ref": "#/definitions/simpleEntity" },
    "date": { "type": ["string", "null"], "format": "date" },
    "canGenerateInvoice": { "type": ["boolean", "null"] },
    "hasExternalInvoicePhoto": { "type": ["boolean", "null"] },
    "isPaidByCash": { "type": ["boolean", "null"] },
    "paidAmount": { "type": ["number", "null"] },
    "sendingPersonName": { "type": ["string", "null"] },
    "sendingPersonRank": { "type": ["string", "null"] },
    "receivingPersonName": { "type": ["string", "null"] },
    "receivingPersonRank": { "type": ["string", "null"] },
    "files": {
      "type": "array",
      "items": { "type": "object" }
    },
    "createdAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "required": ["id", "state"],
  "additionalProperties": true,
  "definitions": {
    "simpleEntity": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": ["string", "null"] }
      },
      "required": ["id"],
      "additionalProperties": true
    },
    "relocationItemBatch": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "amount": { "type": "number" },
        "batchNumber": { "type": ["string", "null"] },
        "isProduced": { "type": ["boolean", "null"] }
      },
      "required": ["amount"],
      "additionalProperties": true
    },
    "relocationItem": {
      "type": "object",
      "properties": {
        "resource": {
          "type": ["object", "null"],
          "properties": {
            "id": { "type": "integer" },
            "name": { "type": ["string", "null"] },
            "active": { "type": ["boolean", "null"] },
            "category": { "type": ["object", "null"] },
            "imagePath": { "type": ["string", "null"] },
            "properties": { "type": ["object", "array", "null"] },
            "unit": { "type": ["object", "null"] },
            "updatedAt": { "type": ["string", "null"] }
          },
          "required": ["id"],
          "additionalProperties": true
        },
        "amount": { "type": "number" },
        "batches": {
          "type": "array",
          "items": { "$ref": "#/definitions/relocationItemBatch" }
        }
      },
      "required": ["resource", "amount"],
      "additionalProperties": true
    }
  }
}
