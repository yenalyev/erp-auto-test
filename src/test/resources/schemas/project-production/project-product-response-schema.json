{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectProductResponse",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": { "type": "integer" },
    "projectCategory": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" }
      }
    },
    "name": { "type": "string" },
    "description": { "type": ["string", "null"] },
    "active": { "type": ["boolean", "null"] },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
