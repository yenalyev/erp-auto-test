{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectProductionResponse",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": { "type": "integer" },
    "createdBy": { "type": ["string", "null"] },
    "start": { "type": ["string", "null"], "format": "date" },
    "createdAt": { "type": ["string", "null"] },
    "deadlineTo": { "type": ["string", "null"], "format": "date" },
    "state": { "type": ["string", "null"], "enum": ["CREATED", "IN_PROGRESS", "DONE", null] },
    "type": { "type": ["string", "null"], "enum": ["CREATION", "MODIFICATION", null] },
    "serialNumber": { "type": ["string", "null"] },
    "description": { "type": ["string", "null"] },
    "storage": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" }
      }
    },
    "equipmentCategory": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" }
      }
    },
    "equipmentModel": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" }
      }
    },
    "equipment": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "integer" },
        "modelName": { "type": ["string", "null"] },
        "serialNumber": { "type": ["string", "null"] },
        "inventoryNumber": { "type": ["string", "null"] }
      }
    },
    "projectProductionStages": {
      "type": "array",
      "items": { "$ref": "project-production-stage-response-schema.json" }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "fileNameOriginal": { "type": ["string", "null"] },
          "extension": { "type": ["string", "null"] }
        }
      }
    }
  },
  "additionalProperties": true
}
