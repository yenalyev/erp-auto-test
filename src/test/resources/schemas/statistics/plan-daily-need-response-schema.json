{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanDailyNeedResponse",
  "type": "object",
  "required": ["resource", "dailyNeed"],
  "properties": {
    "resource": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" }
      },
      "additionalProperties": true
    },
    "dailyNeed": { "type": "number", "minimum": 0 },
    "storage": { "type": ["number", "null"] }
  },
  "additionalProperties": true
}
