{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AccessRoleResponse",
  "type": "object",
  "properties": {
    "id": { "type": "integer" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "scopeKind": { "enum": ["LOCATION", "GLOBAL"] },
    "system": { "type": "boolean" },
    "permissionKeys": { "type": "array", "items": { "type": "string" } },
    "permissionCount": { "type": "integer", "minimum": 0 },
    "holdersCount": { "type": "integer", "minimum": 0 }
  },
  "required": ["id", "name", "scopeKind", "system", "permissionKeys", "permissionCount", "holdersCount"],
  "additionalProperties": true
}
