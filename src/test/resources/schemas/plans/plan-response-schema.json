{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanResponse",
  "type": "object",
  "required": ["id", "description", "storage", "output", "month", "year", "from", "to"],
  "properties": {
    "id": { "type": "integer" },
    "description": { "type": "string" },
    "storage": { "$ref": "../simple-entity-schema.json" },
    "output": {
      "type": "array",
      "items": { "$ref": "../technological-maps/resource-usage-response-schema.json" }
    },
    "month": { "type": "integer" },
    "year": { "type": "integer" },
    "from": { "type": "string", "format": "date" },
    "to": { "type": "string", "format": "date" }
  },
  "additionalProperties": true
}
