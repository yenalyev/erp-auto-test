{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssemblyComponentResponse",
  "type": "object",
  "required": ["resource", "unit", "requiredPerUnit", "availableStock"],
  "properties": {
    "resource": { "$ref": "../simple-entity-schema.json" },
    "unit": { "type": "string" },
    "requiredPerUnit": { "type": "number" },
    "availableStock": { "type": "number" },
    "technologicalMaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "storages"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "storages": {
            "type": "array",
            "items": { "$ref": "../simple-entity-schema.json" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
