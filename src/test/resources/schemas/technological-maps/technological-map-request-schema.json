{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TechnologicalMapRequest",
  "type": "object",
  "required": ["name", "type", "input", "output", "storageIds"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["PRODUCTION", "DISASSEMBLE"]
    },
    "storageIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    },
    "input": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "resource-usage-request-schema.json" }
    },
    "output": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "resource-usage-request-schema.json" }
    }
  },
  "additionalProperties": true
}
