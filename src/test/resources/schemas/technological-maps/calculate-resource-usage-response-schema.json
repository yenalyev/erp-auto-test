{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Calculate resource usage response",
  "type": "array",
  "items": {
    "$ref": "#/definitions/usage"
  },
  "definitions": {
    "simpleEntity": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "number" },
        "name": { "type": "string" }
      }
    },
    "techMapRef": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "number" },
        "name": { "type": "string" },
        "storages": {
          "type": "array",
          "items": { "$ref": "#/definitions/simpleEntity" }
        }
      }
    },
    "component": {
      "type": "object",
      "required": ["resource", "amount", "isRequiresChoice", "components"],
      "additionalProperties": true,
      "properties": {
        "resource": { "$ref": "#/definitions/simpleEntity" },
        "unit": { "type": ["string", "null"] },
        "amount": { "type": "number" },
        "technolMaps": {
          "type": "array",
          "items": { "$ref": "#/definitions/techMapRef" }
        },
        "selectedTmId": { "type": ["number", "null"] },
        "isRequiresChoice": { "type": "boolean" },
        "components": {
          "type": "array",
          "items": { "$ref": "#/definitions/component" }
        }
      }
    },
    "usage": {
      "type": "object",
      "required": ["id", "name", "amount", "components"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "number" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "unit": { "type": ["string", "null"] },
        "storages": {
          "type": "array",
          "items": { "$ref": "#/definitions/simpleEntity" }
        },
        "components": {
          "type": "array",
          "items": { "$ref": "#/definitions/component" }
        }
      }
    }
  }
}
