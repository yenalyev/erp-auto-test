{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Technological Map Update Response (resource references)",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version",
    "groupId",
    "dateTime",
    "input",
    "output"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "PRODUCTION",
        "DISASSEMBLE"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "groupId": {
      "type": "string",
      "format": "uuid"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "storages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "input": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/usage"
      }
    },
    "output": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/usage"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/group"
      }
    }
  },
  "additionalProperties": true,
  "description": "Structural update returns the new entity with id-based resource references. Read populated display metadata through GET.",
  "definitions": {
    "resourceReference": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "required": [
        "resource",
        "amount"
      ],
      "properties": {
        "resource": {
          "$ref": "#/definitions/resourceReference"
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "totalAmount": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "alternative": {
      "type": "object",
      "required": [
        "id",
        "resource",
        "amount",
        "isDefault"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "resource": {
          "$ref": "#/definitions/resourceReference"
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "isDefault": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "name",
        "alternativeResources"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "alternativeResources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/alternative"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
