{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Technological Map Response",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version",
    "groupId",
    "dateTime",
    "input",
    "output"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["PRODUCTION", "DISASSEMBLE"]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "groupId": {
      "type": "string",
      "format": "uuid"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "storages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "input": {
      "type": "array",
      "items": {
        "$ref": "resource-usage-response-schema.json"
      }
    },
    "output": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "resource-usage-response-schema.json"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "alternative-group-response-schema.json"
      }
    }
  },
  "additionalProperties": true
}
