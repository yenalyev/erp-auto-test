{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TechnologicalMapAlternativeGroupRequest",
  "type": "object",
  "required": ["name", "alternativeResources"],
  "properties": {
    "id": { "type": ["integer", "null"], "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "alternativeResources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "alternative-option-request-schema.json" }
    }
  },
  "additionalProperties": true
}
