{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resource Usage Request",
  "type": "object",
  "required": ["resourceId", "amount"],
  "properties": {
    "resourceId": {
      "type": "integer",
      "minimum": 1
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "batchNumber": { "type": ["string", "null"] },
          "amount": { "type": "number", "exclusiveMinimum": 0 },
          "isProduced": { "type": ["boolean", "null"] },
          "accResourceId": { "type": ["string", "null"] },
          "paidAmount": { "type": ["number", "null"], "minimum": 0, "multipleOf": 0.01 }
        },
        "required": ["amount"],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
