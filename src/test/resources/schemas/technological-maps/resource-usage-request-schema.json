{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resource Usage Request",
  "type": "object",
  "required": ["resourceId", "amount"],
  "properties": {
    "resourceId": {
      "type": "integer",
      "minimum": 1
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "batches": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "additionalProperties": true
}
