{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GlobalPlanResponse",
  "type": "object",
  "required": ["id", "description", "month", "year", "from", "to", "output", "generatedPlans"],
  "properties": {
    "id": { "type": "integer" },
    "description": { "type": "string" },
    "month": { "type": "integer" },
    "year": { "type": "integer" },
    "from": { "type": "string", "format": "date" },
    "to": { "type": "string", "format": "date" },
    "output": {
      "type": "array",
      "items": { "$ref": "../technological-maps/resource-usage-response-schema.json" }
    },
    "generatedPlans": {
      "type": "array",
      "items": { "$ref": "generated-plan-response-schema.json" }
    },
    "decomposition": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
