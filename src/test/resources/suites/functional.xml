<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Test-Dev Test Suite" parallel="classes" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Functional Tests">
        <classes>
            <class name="com.erp.tests.functional.measurement_unit.MeasurementUnitTest"/>
            <class name="com.erp.tests.functional.resource.ResourceTest"/>
            <class name="com.erp.tests.functional.resource.ResourceAutocompleteTest"/>
            <class name="com.erp.tests.functional.storage.StorageTest"/>
            <class name="com.erp.tests.functional.relocation.RelocationTest"/>
            <class name="com.erp.tests.functional.relocation.EquipmentRelocationTest"/>
            <class name="com.erp.tests.functional.global_plan.GlobalPlanCrudApiTest"/>
            <class name="com.erp.tests.functional.global_plan.GlobalPlanDecompositionApiTest"/>
            <class name="com.erp.tests.functional.global_plan.GlobalPlanGenerationApiTest"/>
        </classes>
    </test>
</suite>