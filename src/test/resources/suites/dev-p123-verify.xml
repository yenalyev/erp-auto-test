<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  POM/test-contract fixes (plan items 1–3) + narrow API 500 probe (item 4) on DEV.

    mvn test "-Denv=dev" "-Dsuite=dev-p123-verify" "-Dtcm.enabled=false"
-->
<suite name="Dev P123 verify" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="P1-receive-exact">
        <classes>
            <class name="com.erp.tests.ui.RelocationUITest">
                <methods>
                    <include name="externalReceiveJournalAndStock"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="P1-def-008">
        <classes>
            <class name="com.erp.tests.ui.DefectUITest">
                <methods>
                    <include name="testWriteOffFilterDefaultIsAll"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="P2-tm-034">
        <classes>
            <class name="com.erp.tests.ui.TechnologicalMapValidationUITest">
                <methods>
                    <include name="testCannotUpdateProductionTechMapWithInputOutputOverlapViaUi"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="P2-unit-analytics">
        <classes>
            <class name="com.erp.tests.ui.UnitAnalyticsUiTest">
                <methods>
                    <include name="unitAnalyticsTurnoverTabsLoadForPermittedUser"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="P2-rel-vis">
        <classes>
            <class name="com.erp.tests.ui.RelocationVisibilityUiTest"/>
        </classes>
    </test>

    <test name="P3-equipment-create">
        <classes>
            <class name="com.erp.tests.ui.EquipmentCreateUITest"/>
        </classes>
    </test>

    <test name="P3-hierarchy">
        <classes>
            <class name="com.erp.tests.ui.InventoryHierarchyUiTest"/>
        </classes>
    </test>

    <test name="P3-crew-fly-toggle">
        <classes>
            <class name="com.erp.tests.ui.CrewFlyPointInventoryUiTest">
                <methods>
                    <include name="adminTogglesInventorySessionOnFlyPointDeepLink"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="P4-api-500">
        <classes>
            <class name="com.erp.tests.auth.AuthenticationTest">
                <methods>
                    <include name="testEndpointWithValidSession"/>
                </methods>
            </class>
            <class name="com.erp.tests.functional.inventory.InventoryStockApiTest">
                <methods>
                    <include name="tagFilterTwoTagsUsesOrNotAnd"/>
                </methods>
            </class>
            <class name="com.erp.tests.functional.invoice.InvoiceGenerateApiTest">
                <methods>
                    <include name="generateInvoiceForSend"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
