<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Stock-alert highlight + pin-to-top (REQ-ALERT AC-02..04).

  Run:
    mvn test -Denv=dev -Dsuite=next-api-verify-alert-hl
-->
<suite name="Alert Stock Highlight" parallel="none" verbose="1">
    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Alert highlight API">
        <classes>
            <class name="com.erp.tests.functional.alert.AlertStockHighlightApiTest"/>
            <class name="com.erp.tests.functional.alert.AlertStorageTypeApiTest"/>
        </classes>
    </test>

    <test name="Alert highlight UI">
        <classes>
            <class name="com.erp.tests.ui.AlertStockHighlightUiTest"/>
            <class name="com.erp.tests.ui.AlertStorageTypeUiTest"/>
        </classes>
    </test>
</suite>
