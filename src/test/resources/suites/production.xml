<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Production Test Suite" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Production API">
        <classes>
            <class name="com.erp.tests.functional.production.ProductionTest"/>
            <class name="com.erp.tests.functional.production.ProductionJournalFilterApiTest"/>
            <class name="com.erp.tests.functional.production.ProductionHashtagApiTest"/>
            <class name="com.erp.tests.functional.production.ProductionAlternativeInputsTest"/>
            <class name="com.erp.tests.functional.production_order.ProductionOrderApiTest"/>
            <class name="com.erp.tests.functional.production_order.ProductionGroupApiTest"/>
            <class name="com.erp.tests.functional.disassemble.DisassembleCrudApiTest"/>
            <class name="com.erp.tests.functional.shift.ShiftCrudApiTest"/>
            <class name="com.erp.tests.functional.analytics.AnalyticsAuditApiTest"/>
            <class name="com.erp.tests.functional.analytics.PlanAnalyticApiTest"/>
        </classes>
    </test>

    <test name="Production UI">
        <classes>
            <class name="com.erp.tests.ui.ProductionUITest"/>
            <class name="com.erp.tests.ui.ProductionGroupsUiTest"/>
            <class name="com.erp.tests.ui.ProductionJournalFilterUITest"/>
            <class name="com.erp.tests.ui.ProductionJournalDatePickerUiTest"/>
            <class name="com.erp.tests.ui.ProductionHashtagUITest"/>
            <class name="com.erp.tests.ui.OperationHistoryUiTest"/>
            <class name="com.erp.tests.ui.OperationHistoryCardsVisibilityUiTest"/>
            <class name="com.erp.tests.ui.CoverageGapUiSmokeTest"/>
            <class name="com.erp.tests.ui.ProductionAnalyticsDatePickerUiTest"/>
            <class name="com.erp.tests.ui.PlanAnalyticsUiTest"/>
        </classes>
    </test>
</suite>
