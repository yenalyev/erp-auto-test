<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Notifications (chatbot) domain suite — recipients, templates, subscriptions, journal, UI.

  Run:
    mvn test -Denv=dev -Dsuite=notifications

  Prerequisite: ADMIN must have Notification_Manager-ROLE (or atomic perm_notification*).
-->
<suite name="Notifications Test Suite" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Notifications API">
        <classes>
            <class name="com.erp.tests.functional.notification.NotificationRecipientTest"/>
            <class name="com.erp.tests.functional.notification.NotificationTemplateTest"/>
            <class name="com.erp.tests.functional.notification.NotificationSubscriptionTest"/>
            <class name="com.erp.tests.functional.notification.NotificationJournalTest"/>
            <class name="com.erp.tests.functional.notification.NotificationEscapingTest"/>
        </classes>
    </test>

    <test name="Notifications UI">
        <classes>
            <class name="com.erp.tests.ui.NotificationsUITest"/>
        </classes>
    </test>
</suite>
