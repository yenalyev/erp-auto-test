<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Project Production Test Suite" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Project Production API">
        <classes>
            <class name="com.erp.tests.functional.project_production.ProjectProductionTest"/>
            <class name="com.erp.tests.functional.project_production.ProjectProductionTemplateTest"/>
            <class name="com.erp.tests.functional.project_production.ProjectCatalogTest"/>
        </classes>
    </test>

    <test name="Project Production UI">
        <classes>
            <class name="com.erp.tests.ui.ProjectProductionUITest"/>
        </classes>
    </test>
</suite>
