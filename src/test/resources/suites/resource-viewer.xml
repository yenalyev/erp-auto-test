<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Resource Viewer domain suite (/resources-viewer/*).

  Run:
    mvn test -Denv=dev -Dsuite=resource-viewer
-->
<suite name="Resource Viewer Test Suite" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Resource Viewer API">
        <classes>
            <class name="com.erp.tests.functional.storage.RoleStorageSelectorApiTest">
                <methods>
                    <include name="testResourceViewerMyUnitsExcludesUnitType"/>
                </methods>
            </class>
            <class name="com.erp.tests.functional.resource_viewer.ResourceViewerRelocationSumTest"/>
            <class name="com.erp.tests.functional.resource_viewer.ResourceViewerRelocationFilterTest"/>
            <class name="com.erp.tests.functional.resource_viewer.ResourceViewerBomApiTest">
                <methods>
                    <exclude name="testTechMapLookupByRelocationDate"/>
                </methods>
            </class>
            <class name="com.erp.tests.functional.resource_viewer.ResourceViewerAlternativeGroupsApiTest"/>
            <class name="com.erp.tests.functional.resource_viewer.ResourceViewerFilterApiTest"/>
            <class name="com.erp.tests.functional.resource_viewer.ResourceViewerExportApiTest"/>
        </classes>
    </test>

    <test name="Resource Viewer UI">
        <classes>
            <class name="com.erp.tests.ui.ResourceViewerUiTest"/>
        </classes>
    </test>
</suite>
