<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Relocation Test Suite" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Relocation API">
        <classes>
            <class name="com.erp.tests.functional.relocation.RelocationTest"/>
            <class name="com.erp.tests.functional.relocation.RelocationExtendedTest"/>
            <class name="com.erp.tests.functional.relocation.RelocationJournalSortApiTest"/>
            <class name="com.erp.tests.functional.relocation.EquipmentRelocationTest"/>
            <class name="com.erp.tests.functional.relocation.RelocationIncidentTest"/>
        </classes>
    </test>

    <test name="Relocation UI">
        <classes>
            <class name="com.erp.tests.ui.RelocationUITest"/>
            <class name="com.erp.tests.ui.RelocationJournalFilterSortUITest"/>
            <class name="com.erp.tests.ui.EquipmentRelocationUITest"/>
            <class name="com.erp.tests.ui.RelocationIncidentUITest"/>
        </classes>
    </test>
</suite>
