<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Reconfirm parked product UI on current dev (RBAC matrix excluded).

    mvn test "-Denv=dev" "-Dsuite=next-product-reconfirm-ui" "-Dtcm.enabled=false"
-->
<suite name="Product-reconfirm-UI" parallel="none" verbose="1">
    <listeners>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>
    <test name="product-ui">
        <classes>
            <class name="com.erp.tests.ui.UnitAnalyticsUiTest">
                <methods>
                    <include name="unitAnalyticsTurnoverTabsLoadForPermittedUser"/>
                    <include name="monthlyTabAllLocationsScopedToOwnerTree"/>
                    <include name="byResourceTabAllLocationsScopedToOwnerTree"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.RelocationIncidentUITest">
                <methods>
                    <include name="lostTabShowsOnlyWriteOffNotSentAfterPartialDelivery"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.EquipmentHistoryOnOperationsUiTest">
                <methods>
                    <include name="editedEquipmentSendShowsUpdatedDescriptionOnOperationHistory"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.EquipmentUnitHistoryUiTest">
                <methods>
                    <include name="unitHistoryShowsEditedSendDescription"/>
                    <include name="editSendDoesNotDuplicateSentInUnitHistory"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.CrewJournalNameVisibilityUiTest">
                <methods>
                    <include name="receivedTabHidesNonCrewOutsiderName"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.NotificationsUITest">
                <methods>
                    <include name="createRecipientViaDialog"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.NotificationRelocationGoUiTest">
                <methods>
                    <include name="adminGoSwitchesWorkspaceToSender"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.FlyPointDashboardLoadingUiTest">
                <methods>
                    <include name="stocksTableVisibleWhileShortStatsPending"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.AccountantCabinetUITest">
                <methods>
                    <include name="accountantWorkspaceExcludesUnitLocations"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
