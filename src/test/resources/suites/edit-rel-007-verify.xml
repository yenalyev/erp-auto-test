<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Тимчасовий сьют: редагування переміщення в дорозі (REQ-EDIT_REL-007).
  Лише нові кейси (API ресурсів, обладнання, UI). Без parallel — один Playwright.

  З каталогу erp-auto-test:
    mvn test -Denv=dev -Dsuite=edit-rel-007-verify
  З імпортом статусів у TCM (картка фічі):
    mvn test -Denv=dev -Dsuite=edit-rel-007-verify -Dtcm.feature.id=105
-->
<suite name="REQ-EDIT_REL-007 verify" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="In-transit send API">
        <classes>
            <class name="com.erp.tests.functional.relocation.RelocationTest">
                <methods>
                    <include name="testEditInTransitReduceAmount"/>
                    <include name="testEditInTransitIncreaseAmount"/>
                    <include name="testEditSendAfterFinishedReturns400"/>
                    <include name="testRecipientCannotEditInTransitButAdminCan"/>
                    <include name="testEditInTransitStaleVersionReturns409"/>
                    <include name="testRecipientAcceptsEditedInTransitQuantity"/>
                </methods>
            </class>
            <class name="com.erp.tests.functional.relocation.RelocationInTransitEditTest"/>
        </classes>
    </test>

    <test name="In-transit equipment API">
        <classes>
            <class name="com.erp.tests.functional.relocation.EquipmentRelocationTest">
                <methods>
                    <include name="swapInTransitEquipmentUnit"/>
                    <include name="recipientCannotEditInTransitEquipment"/>
                    <include name="inTransitEquipmentCannotBeEditedViaReceive"/>
                    <include name="cannotRedirectInTransitEquipmentToUnit"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="In-transit edit UI">
        <classes>
            <class name="com.erp.tests.ui.RelocationEditActionsUiTest">
                <methods>
                    <include name="senderSeesEditOnInTransit"/>
                    <include name="recipientDoesNotSeeEditOnInTransit"/>
                    <include name="finishedSendLeavesInTransitTab"/>
                    <include name="allLocationsHidesInTransitEdit"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
