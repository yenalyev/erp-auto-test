<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Relocation edit return filters recheck" parallel="none" verbose="1">
    <listeners>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
    </listeners>
    <test name="Latest snapshot on both tabs">
        <classes>
            <class name="com.erp.tests.ui.RelocationEditReturnFiltersUiTest">
                <methods><include name="reopeningEditorUsesLatestSnapshot"/></methods>
            </class>
        </classes>
    </test>
</suite>
