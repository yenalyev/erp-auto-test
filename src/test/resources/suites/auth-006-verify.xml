<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Narrow verify: TC-AUTH-006 only.

    mvn test "-Denv=dev" "-Dsuite=auth-006-verify" "-Dtcm.enabled=false"
-->
<suite name="AUTH-006 verify" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="TC-AUTH-004..006">
        <classes>
            <class name="com.erp.tests.auth.AuthenticationTest">
                <methods>
                    <include name="testEndpointWithoutToken"/>
                    <include name="testEndpointWithInvalidToken"/>
                    <include name="testEndpointWithValidSession"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
