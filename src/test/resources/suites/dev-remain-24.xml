<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Remaining run85 buckets 2–4 on DEV (not product B, not already-green C).

    2 = staging-infra FAIL/SKIP (API + UI)
    3 = UI/test-contract leftovers (RBAC matrix parked)
    4 = JDBC / Fight / env known-skips  (needs -Duse.database=true)

    mvn test -Denv=dev -Dsuite=dev-remain-24 -Duse.database=true -Dtcm.enabled=false
-->
<suite name="Dev remain 2-4" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
