<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Bucket B stock-contract (run #85 FAIL-API).

    mvn test "-Denv=dev" "-Dsuite=next-api-verify-stock" "-Dtcm.enabled=false"
-->
<suite name="BucketB-StockContract" parallel="none" verbose="1">
    <listeners>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>
    <test name="B-stock-contract">
        <classes>
            <class name="com.erp.tests.functional.inventory.InventoryHierarchyApiTest">
                <methods>
                    <include name="hierarchyIncludesParentAndChildStock"/>
                    <include name="deepNestLeafVisibleFromRoot"/>
                    <include name="singleStorageGetExcludesChildOnlyStock"/>
                </methods>
            </class>
            <class name="com.erp.tests.functional.inventory.InventoryMultiLocationExportApiTest">
                <methods>
                    <include name="multiLocationOwnerExportsAllLocationsExcel"/>
                </methods>
            </class>
            <class name="com.erp.tests.functional.disassemble.DisassembleCrudApiTest">
                <methods>
                    <include name="createDisassembleAdjustsStock"/>
                </methods>
            </class>
            <class name="com.erp.tests.functional.shift.ShiftCrudApiTest">
                <methods>
                    <include name="outsiderCannotCreateShiftOnOwner1"/>
                </methods>
            </class>
            <class name="com.erp.tests.functional.resource.ResourceDeactivationTest">
                <methods>
                    <include name="testCannotModifyProductionWhenTechMapResourceDeactivated"/>
                </methods>
            </class>
            <class name="com.erp.tests.functional.storage.CrewFlyPointInventoryTest">
                <methods>
                    <include name="attachedCrewInventoryPutProxiesToFlyPoint"/>
                    <include name="attachedCrewPutEquivalentToDirectFlyPointPut"/>
                </methods>
            </class>
            <class name="com.erp.tests.functional.storage.FlyPointInventoryTest">
                <methods>
                    <include name="multiLocationInventoryIncludesFlyPoint"/>
                    <include name="putUnknownResourceOnFlyPointReturns4xx"/>
                </methods>
            </class>
            <class name="com.erp.tests.functional.storage.AccountantRelocationFilterTest">
                <methods>
                    <include name="testAccountantSeesOnlyStorageToUnitRelocations"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
