<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Re-check POST /storages after backend pull.

    mvn test "-Denv=dev" "-Dsuite=next-api-probe-storage" "-Dtcm.enabled=false"
-->
<suite name="StorageCreateRecheck" parallel="none" verbose="1">
    <listeners>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>
    <test name="TC-STR-001">
        <classes>
            <class name="com.erp.tests.functional.storage.StorageTest">
                <methods>
                    <include name="testCreateStorage"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
