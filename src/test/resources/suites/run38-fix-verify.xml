<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Targeted verify of run #38 autotest fixes (fixtures, isolation, UI waits).
  Not full regression. Skips product ACL / HTTP 500 cases.

  mvn test -Denv=dev -Dsuite=run38-fix-verify
-->
<suite name="Run38 Fix Verify" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Fixtures">
        <classes>
            <class name="com.erp.tests.functional.notification.NotificationEscapingTest">
                <methods>
                    <include name="stockRedJournalPreservesMarkupSpecialCharsInStorageName"/>
                    <include name="stockRedJournalPreservesWhatsAppBoldTrapInStorageName"/>
                    <include name="stockRedJournalPreservesJsonCriticalCharsInStorageName"/>
                </methods>
            </class>
            <class name="com.erp.tests.functional.production.ProductionAlternativeInputsTest">
                <methods>
                    <include name="testGroupsOnlyProduceWithNonDefaultWhenDefaultStockZero"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.PlanExecutionUiTest">
                <methods>
                    <include name="testOwnerNoPlanNoProduction"/>
                    <include name="testAdminNoPlanNoProduction"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="StockIsolation">
        <classes>
            <class name="com.erp.tests.functional.disassemble.DisassembleCrudApiTest"/>
            <class name="com.erp.tests.functional.inventory.InventoryHierarchyApiTest">
                <methods>
                    <include name="hierarchyIncludesParentAndChildStock"/>
                    <include name="singleStorageGetExcludesChildOnlyStock"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="HistoryWaits">
        <classes>
            <class name="com.erp.tests.ui.OperationHistoryUiTest">
                <methods>
                    <include name="nspQtyGreaterThanOneUsesTotalInHistory"/>
                    <include name="nspDoneUsageShownInHistory"/>
                    <include name="disassembleActualProducedAmountShownInHistory"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.OperationHistoryCardsVisibilityUiTest">
                <methods>
                    <include name="ownerSeesDefectAndProductionCards"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.CrewIssuanceUITest">
                <methods>
                    <include name="testIssuedSummaryCardAfterCrewSend"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.RelocationIncidentUITest">
                <methods>
                    <include name="operationHistoryAfterIncidentUi"/>
                    <include name="operationHistoryAfterPartialDeliveryUi"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.InventoryUiTest">
                <methods>
                    <include name="operationHistoryAfterInventoryUi"/>
                    <include name="tagChipsTwoSelectedUseOrLogicUi"/>
                </methods>
            </class>
            <class name="com.erp.tests.functional.inventory.InventoryStockApiTest">
                <methods>
                    <include name="inventoryRecordedInOperationHistory"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="UiTimeoutWaits">
        <classes>
            <class name="com.erp.tests.ui.OrderListUiTest">
                <methods>
                    <include name="resourceFilterAndReset"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.TechnologicalMapAlternativeGroupsUITest">
                <methods>
                    <include name="testCreateTechMapWithSwitchedDefaultViaUi"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.UnitAnalyticsUiTest">
                <methods>
                    <include name="unitAnalyticsTurnoverTabsLoadForPermittedUser"/>
                    <include name="monthlyTabAllLocationsScopedToOwnerTree"/>
                    <include name="byResourceTabAllLocationsScopedToOwnerTree"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.InventoryHierarchyUiTest">
                <methods>
                    <include name="exportExcelWithAndWithoutHierarchyCheckbox"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
