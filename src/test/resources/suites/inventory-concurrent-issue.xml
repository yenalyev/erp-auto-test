<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Inventory concurrent issue" parallel="none" verbose="1">
    <listeners>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
    </listeners>
    <test name="Inventory during issue API and two-tab UI">
        <classes>
            <class name="com.erp.tests.functional.inventory.InventoryConcurrentIssueApiTest"/>
            <class name="com.erp.tests.ui.InventoryConcurrentIssueUiTest"/>
        </classes>
    </test>
</suite>
