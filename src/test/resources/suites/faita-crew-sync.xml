<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Release contract for FAITA crew sync and journal position. Run: mvn test -Denv=dev -Dsuite=faita-crew-sync -Dtcm.enabled=false -Dgoogle.sheets.enabled=false -->
<suite name="FAITA Crew Sync" parallel="none" verbose="1">
    <listeners>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
    </listeners>
    <test name="FAITA write-off API contract">
        <classes>
            <class name="com.erp.tests.functional.storage.FaitaCrewSyncContractTest"/>
        </classes>
    </test>
    <test name="FAITA write-off UI contract">
        <classes>
            <class name="com.erp.tests.ui.FaitaCrewSyncPositionUiTest"/>
        </classes>
    </test>
</suite>
