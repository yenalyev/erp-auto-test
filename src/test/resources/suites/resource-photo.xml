<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Resource photo delete: API + UI.
  mvn test -Denv=dev -Dsuite=resource-photo
-->
<suite name="Resource Photo Suite" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Resource photo API">
        <classes>
            <class name="com.erp.tests.functional.resource.ResourceImageApiTest"/>
        </classes>
    </test>

    <test name="Resource photo UI">
        <classes>
            <class name="com.erp.tests.ui.ResourcePhotoUiTest"/>
        </classes>
    </test>
</suite>
