<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  REQ-WMS-007 AC-09/AC-10: Excel з/без нулів + Copy TSV (одиниця в окремій колонці).

  mvn test "-Denv=dev" "-Dsuite=next-wms-007-export-copy"
-->
<suite name="WMS-007 export zeros and copy TSV" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="API export zeros">
        <classes>
            <class name="com.erp.tests.functional.inventory.InventoryStockApiTest">
                <methods>
                    <include name="exportExcelWithAndWithoutZeroStock"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="UI export zeros and copy">
        <classes>
            <class name="com.erp.tests.ui.InventoryUiTest">
                <methods>
                    <include name="copyRemaindersToClipboardUi"/>
                    <include name="exportExcelWithAndWithoutZeroStockUi"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
