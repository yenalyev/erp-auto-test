<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="UI Dev Test Suite" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Login / Logout UI — admin + owner1">
        <classes>
            <class name="com.erp.tests.ui.LoginLogoutUITest"/>
            <class name="com.erp.tests.ui.WorkspaceSelectorUiTest"/>
            <class name="com.erp.tests.ui.AccountantCabinetUITest"/>
            <class name="com.erp.tests.ui.CrewIssuanceUITest"/>
            <class name="com.erp.tests.ui.CrewReturnUITest"/>
            <class name="com.erp.tests.ui.CrewJournalNameVisibilityUiTest"/>
            <class name="com.erp.tests.ui.CrewResourceVisibilityUiTest"/>
            <class name="com.erp.tests.ui.CrewFlyPointInventoryUiTest"/>
            <class name="com.erp.tests.ui.UnitResourceDictionaryUiTest"/>
            <class name="com.erp.tests.ui.UsersAdminAccessUiTest"/>
            <class name="com.erp.tests.ui.UnitAnalyticsUiTest"/>
        </classes>
    </test>

</suite>
