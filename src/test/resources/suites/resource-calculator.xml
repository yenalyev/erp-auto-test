<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Калькулятор розхідників /technological-maps/resource-calculator (REQ-MFG-001-CALC, TC-TM-CALC-*).

  Run:
    mvn test -Denv=dev -Dsuite=resource-calculator
-->
<suite name="Resource Calculator" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Resource calculator API">
        <classes>
            <class name="com.erp.tests.functional.tech_map.TechnologicalMapResourceCalculatorApiTest"/>
        </classes>
    </test>

    <test name="Resource calculator UI">
        <classes>
            <class name="com.erp.tests.ui.ResourceCalculatorUiTest"/>
        </classes>
    </test>
</suite>
