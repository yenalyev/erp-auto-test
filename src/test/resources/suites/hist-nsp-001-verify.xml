<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Verify TC-UI-HIST-NSP-001: NSP used resource in /history table.
  mvn test -Denv=dev -Dsuite=hist-nsp-001-verify
-->
<suite name="HIST-NSP-001 Verify (dev)" parallel="none" verbose="1">
    <listeners>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>
    <test name="NSP used in history table">
        <classes>
            <class name="com.erp.tests.ui.OperationHistoryUiTest">
                <methods>
                    <include name="nspUsedResourceAppearsInHistoryTable"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
