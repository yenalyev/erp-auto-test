<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  DELETE повернення CREW: attached → FLY_POINT, unattached → CREW.

    mvn test "-Denv=dev" "-Dsuite=next-api-verify-crew-ret-del"
-->
<suite name="CrewReturnDelete" parallel="none" verbose="1">
    <listeners>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>
    <test name="TC-CREW-RET-005-006">
        <classes>
            <class name="com.erp.tests.functional.storage.CrewReturnTest">
                <methods>
                    <include name="attachedCrewReturnDeleteRestoresFlyPointNotCrew"/>
                    <include name="unattachedCrewReturnDeleteRestoresCrew"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
