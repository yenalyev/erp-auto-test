<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Low-value write-off Excel export" parallel="none" verbose="1">
    <listeners>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>
    <test name="Isolated МШП Excel and real filters">
        <classes>
            <class name="com.erp.tests.ui.LowValueWriteOffExportUiTest"/>
        </classes>
    </test>
    <test name="Write-off journal adjacent regression">
        <classes>
            <class name="com.erp.tests.ui.LowValueWriteOffTest">
                <methods>
                    <include name="journalFiltersAndPagination"/>
                    <include name="journalRbac"/>
                    <include name="journalLocationAndPeriodFilters"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
