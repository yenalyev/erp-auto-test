<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Retry hierarchy + multi-location export after Keycloak #username timeout. -->
<suite name="BucketB-StockRetry" parallel="none" verbose="1">
    <listeners>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>
    <test name="hierarchy-export-retry">
        <classes>
            <class name="com.erp.tests.functional.inventory.InventoryHierarchyApiTest">
                <methods>
                    <include name="hierarchyIncludesParentAndChildStock"/>
                    <include name="deepNestLeafVisibleFromRoot"/>
                    <include name="singleStorageGetExcludesChildOnlyStock"/>
                </methods>
            </class>
            <class name="com.erp.tests.functional.inventory.InventoryMultiLocationExportApiTest">
                <methods>
                    <include name="multiLocationOwnerExportsAllLocationsExcel"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
