<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Equipment domain suite — CRUD, relocations, assignee filter.

  Run:
    mvn test -Denv=dev -Dsuite=equipment
-->
<suite name="Equipment Test Suite" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Equipment API">
        <classes>
            <class name="com.erp.tests.functional.equipment.EquipmentSelectorContractTest"/>
            <class name="com.erp.tests.functional.relocation.EquipmentRelocationTest"/>
        </classes>
    </test>

    <test name="Equipment UI">
        <classes>
            <class name="com.erp.tests.ui.EquipmentAssigneeFilterUITest"/>
            <class name="com.erp.tests.ui.EquipmentRelocationUITest"/>
        </classes>
    </test>
</suite>
