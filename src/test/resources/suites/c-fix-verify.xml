<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Remaining bucket-C fixes except RBAC matrix (do not run RbacAccessMatrixTest).

    mvn test -Denv=staging -Dsuite=c-fix-verify
-->
<suite name="C-fix verify without RBAC (staging)" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="PO-targetStorageId">
        <classes>
            <class name="com.erp.tests.functional.production_order.ProductionOrderApiTest"/>
        </classes>
    </test>

    <test name="UI-EQ-group-sort">
        <classes>
            <class name="com.erp.tests.ui.EquipmentGroupSortUITest"/>
        </classes>
    </test>

    <test name="UI-bundle-receive-exact">
        <classes>
            <class name="com.erp.tests.ui.ResourceBundleApplyUiTest">
                <methods>
                    <include name="badgesAbsentOnReceiveForm"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
