<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  AC-GP-16 remaining guards: historical archive/structure, current-month rename/structure,
  past+actual actual-wins.
  mvn test -Denv=dev -Dsuite=gp-ac-gp-16-gaps
-->
<suite name="AC-GP-16 remaining guards" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="TC-GP-056 057 061 historical">
        <classes>
            <class name="com.erp.tests.functional.global_plan.GlobalPlanHistoricalTechMapApiTest">
                <methods>
                    <include name="testCanArchiveTechMapWhenOnlyInHistoricalGlobalPlan"/>
                    <include name="testCanUpdateTechMapStructureWhenOnlyInHistoricalGlobalPlan"/>
                    <include name="testActualGlobalPlanGuardWinsWhenMapAlsoInHistoricalPlan"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="TC-GP-058 059 current month">
        <classes>
            <class name="com.erp.tests.functional.global_plan.GlobalPlanTechMapDeactivationGuardTest">
                <methods>
                    <include name="testCanUpdateTechMapNameWhenUsedInCurrentMonthGlobalPlan"/>
                    <include name="testCannotUpdateTechMapStructureWhenUsedInCurrentMonthGlobalPlan"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
