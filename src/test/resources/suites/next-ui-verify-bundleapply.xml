<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="BundleApply" parallel="none" verbose="1">
    <listeners>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>
    <test name="BundleApply">
        <classes>
            <class name="com.erp.tests.ui.ResourceBundleApplyUiTest">
                <methods>
                    <include name="badgeVisibleWithHoverResources"/>
                    <include name="applyFillsRowsWithEmptyQuantity"/>
                    <include name="reapplyShowsAlreadyAddedToast"/>
                    <include name="noStockShowsToast"/>
                    <include name="partialApplyAddsOnlyMissing"/>
                    <include name="applyOnCrewIssuanceForm"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
