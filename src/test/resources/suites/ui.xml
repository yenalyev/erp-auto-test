<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="UI Test Suite" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Login UI">
        <classes>
            <class name="com.erp.tests.ui.LoginUITest"/>
        </classes>
    </test>

    <test name="Resources UI">
        <classes>
            <class name="com.erp.tests.ui.ResourceAutocompleteUiTest"/>
        </classes>
    </test>

    <test name="Relocation UI">
        <classes>
            <class name="com.erp.tests.ui.RelocationUITest"/>
            <class name="com.erp.tests.ui.RelocationSendRecipientUiTest"/>
            <class name="com.erp.tests.ui.RelocationInvoiceVisibilityUiTest"/>
            <class name="com.erp.tests.ui.RelocationJournalFilterSortUITest"/>
            <class name="com.erp.tests.ui.EquipmentRelocationUITest"/>
        </classes>
    </test>

    <test name="Equipment UI">
        <classes>
            <class name="com.erp.tests.ui.EquipmentAssigneeFilterUITest"/>
            <class name="com.erp.tests.ui.EquipmentCreateUITest"/>
        </classes>
    </test>

    <test name="Global Plans UI">
        <classes>
            <class name="com.erp.tests.ui.GlobalPlansUiTest"/>
            <class name="com.erp.tests.ui.GlobalPlanCreateUiTest"/>
            <class name="com.erp.tests.ui.GlobalPlanEditAddOutputUiTest"/>
            <class name="com.erp.tests.ui.GlobalPlanRequirementsUiTest"/>
            <class name="com.erp.tests.ui.GlobalPlanDeleteUiTest"/>
            <class name="com.erp.tests.ui.GlobalPlanEditAmountUiTest"/>
        </classes>
    </test>

    <test name="Plan Execution UI">
        <classes>
            <class name="com.erp.tests.ui.PlanExecutionUiTest"/>
        </classes>
    </test>

    <test name="Technological Maps UI">
        <classes>
            <class name="com.erp.tests.ui.TechnologicalMapValidationUITest"/>
        </classes>
    </test>

    <test name="Operation History UI">
        <classes>
            <class name="com.erp.tests.ui.OperationHistoryCardsVisibilityUiTest"/>
        </classes>
    </test>

</suite>
