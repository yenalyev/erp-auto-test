<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="UI Test Suite" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Login UI">
        <classes>
            <class name="com.erp.tests.ui.LoginUITest"/>
        </classes>
    </test>

    <test name="Resources UI">
        <classes>
            <class name="com.erp.tests.ui.ResourceAutocompleteUiTest"/>
        </classes>
    </test>

    <test name="Relocation UI">
        <classes>
            <class name="com.erp.tests.ui.RelocationUITest"/>
            <class name="com.erp.tests.ui.RelocationJournalFilterSortUITest"/>
            <class name="com.erp.tests.ui.EquipmentRelocationUITest"/>
        </classes>
    </test>

    <test name="Global Plans UI">
        <classes>
            <class name="com.erp.tests.ui.GlobalPlansUiTest"/>
            <class name="com.erp.tests.ui.GlobalPlanCreateUiTest"/>
        </classes>
    </test>

</suite>
