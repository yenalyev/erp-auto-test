<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  FAIL-UI leftover after remain-24 (not in that suite).

    mvn test "-Denv=dev" "-Dsuite=next-ui-verify-fail85" "-Dtcm.enabled=false"
-->
<suite name="Fail85-UI-leftover" parallel="none" verbose="1">
    <listeners>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>
    <test name="accountant-eq-tm">
        <classes>
            <class name="com.erp.tests.ui.AccountantCabinetUITest">
                <methods>
                    <include name="accountantWorkspaceExcludesUnitLocations"/>
                    <include name="accountantLogisticsHidesUnitToCrew"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.EquipmentGroupSortUITest">
                <methods>
                    <include name="expandedGroupShowsItemsSortedByInventoryNumber"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.EquipmentUnitHistoryUiTest">
                <methods>
                    <include name="unitHistoryShowsReturnedAfterAssignmentReturn"/>
                    <include name="unitHistoryShowsEditedSendDescription"/>
                    <include name="editSendDoesNotDuplicateSentInUnitHistory"/>
                </methods>
            </class>
            <class name="com.erp.tests.ui.TechnologicalMapHierarchyUITest">
                <methods>
                    <include name="parentWorkspaceShowsEntireSubtreeMaps"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
