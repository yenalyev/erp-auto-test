<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Full regression suite — API + RBAC + UI.

  Run:
    mvn test -Denv=dev -Dsuite=regression

  Ordering notes:
    - parallel="none" — tests run sequentially in document order.
    - ResourceDeactivationTest (TC-RES-015 alerts) runs before Inventory API/UI
      so alert teardown does not affect залишки tests on the same storage.
    - StorageRegionTest → StorageVisibilityTest → RelocationVisibility* (shared owner2 storage).
    - Includes all domain suites: smoke, functional subsets, inventory, production,
      relocations, storage-regions, global-plans, technological-maps, defects,
      resource-viewer, rbac, ui, bots (smoke block).
-->
<suite name="ERP Regression Suite" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Smoke">
        <classes>
            <class name="com.erp.tests.auth.LoginSmokeTest"/>
            <class name="com.erp.tests.integration.BotInternalApiLatencyTest"/>
        </classes>
    </test>

    <test name="Authentication">
        <classes>
            <class name="com.erp.tests.auth.AuthenticationTest"/>
        </classes>
    </test>

    <test name="RBAC Access Matrix">
        <classes>
            <class name="com.erp.tests.rbac.RbacAccessMatrixTest"/>
        </classes>
    </test>

    <test name="Dictionary API">
        <classes>
            <class name="com.erp.tests.functional.measurement_unit.MeasurementUnitTest"/>
            <class name="com.erp.tests.functional.resource.ResourceTest"/>
            <class name="com.erp.tests.functional.resource.ResourceAutocompleteTest"/>
            <class name="com.erp.tests.functional.resource.ResourceDeactivationTest"/>
            <class name="com.erp.tests.functional.storage.StorageTest"/>
            <class name="com.erp.tests.functional.storage.StorageRelationTest"/>
            <class name="com.erp.tests.functional.storage.StorageFieldLengthValidationTest"/>
            <class name="com.erp.tests.functional.storage.StorageDeactivationTest"/>
            <class name="com.erp.tests.functional.storage.StorageRegionTest"/>
            <class name="com.erp.tests.functional.storage.StorageVisibilityTest"/>
            <class name="com.erp.tests.functional.storage.StorageNamesEndpointTest"/>
            <class name="com.erp.tests.functional.storage.StorageResourceVisibilityTest"/>
            <class name="com.erp.tests.functional.storage.RelocationVisibilityTest"/>
            <class name="com.erp.tests.functional.storage.RelocationInvoiceVisibilityTest"/>
            <class name="com.erp.tests.functional.storage.StorageCrewRegionTest"/>
            <class name="com.erp.tests.functional.storage.CrewVisibilityTest"/>
            <class name="com.erp.tests.functional.storage.CrewRelocationTest"/>
            <class name="com.erp.tests.functional.storage.CrewInventoryTest"/>
        </classes>
    </test>

    <test name="Resource Viewer API">
        <classes>
            <class name="com.erp.tests.functional.resource_viewer.ResourceViewerRelocationSumTest"/>
        </classes>
    </test>

    <test name="Technological Maps API">
        <classes>
            <class name="com.erp.tests.functional.tech_map.TechnologicalMapTest"/>
            <class name="com.erp.tests.functional.tech_map.TechnologicalMapDeactivationPlanGuardTest"/>
            <class name="com.erp.tests.functional.tech_map.TechnologicalMapValidationTest"/>
        </classes>
    </test>

    <test name="Production API">
        <classes>
            <class name="com.erp.tests.functional.production.ProductionTest"/>
            <class name="com.erp.tests.functional.production.ProductionJournalFilterApiTest"/>
        </classes>
    </test>

    <test name="Non-Series Production API">
        <classes>
            <class name="com.erp.tests.functional.non_series_production.NonSeriesProductionTest"/>
        </classes>
    </test>

    <test name="Defects API">
        <classes>
            <class name="com.erp.tests.functional.defect.DefectTest"/>
        </classes>
    </test>

    <test name="Relocation API">
        <classes>
            <class name="com.erp.tests.functional.relocation.RelocationTest"/>
            <class name="com.erp.tests.functional.relocation.RelocationExtendedTest"/>
            <class name="com.erp.tests.functional.relocation.RelocationJournalSortApiTest"/>
            <class name="com.erp.tests.functional.relocation.EquipmentRelocationTest"/>
            <class name="com.erp.tests.functional.equipment.EquipmentSelectorContractTest"/>
