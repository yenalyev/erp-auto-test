            <class name="com.erp.tests.functional.global_plan.GlobalPlanDecompositionApiTest"/>
            <class name="com.erp.tests.functional.global_plan.GlobalPlanGenerationApiTest"/>
            <class name="com.erp.tests.functional.global_plan.GlobalPlanEditAfterTechMapDeactivationTest"/>
            <class name="com.erp.tests.functional.global_plan.GlobalPlanTechMapDeactivationGuardTest"/>
            <class name="com.erp.tests.functional.global_plan.PlanListSortApiTest"/>
        </classes>
    </test>

    <test name="UI Auth">
