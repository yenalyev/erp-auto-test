<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  KNOWN-SKIP leftovers not in remain-24 + SKIP-UI method remain-24 omitted.

    mvn test "-Denv=dev" "-Dsuite=next-verify-skip85-left" "-Dtcm.enabled=false"
-->
<suite name="Skip85-leftover" parallel="none" verbose="1">
    <listeners>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>
    <test name="known-skip-api">
        <classes>
            <class name="com.erp.tests.functional.order.OrderCrudApiTest">
                <methods>
                    <include name="testCreateResourceNotAccessibleToLocationReturns400"/>
                </methods>
            </class>
            <class name="com.erp.tests.functional.storage.StorageTest">
                <methods>
                    <include name="testCreateDuplicateStorage"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="bundle-026">
        <classes>
            <class name="com.erp.tests.ui.ResourceBundleApplyUiTest">
                <methods>
                    <include name="badgesAbsentOnReceiveForm"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
