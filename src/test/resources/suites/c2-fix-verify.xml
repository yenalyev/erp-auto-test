<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Narrow staging recheck after bucket-C2 test fixes:
  hierarchy seedExactStock, STR-003 self-seed, ORD-005 REGIONS location, Fight GET as ADMIN.

    mvn test -Denv=staging -Dsuite=c2-fix-verify
-->
<suite name="C2 fix verify (staging)" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Hierarchy-exact-stock">
        <classes>
            <class name="com.erp.tests.functional.inventory.InventoryHierarchyApiTest"/>
        </classes>
    </test>

    <test name="STR-003">
        <classes>
            <class name="com.erp.tests.functional.storage.StorageTest">
                <methods>
                    <include name="testCreateDuplicateStorage"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="ORD-005">
        <classes>
            <class name="com.erp.tests.functional.order.OrderCrudApiTest">
                <methods>
                    <include name="testCreateResourceNotAccessibleToLocationReturns400"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="FIGHT-001">
        <classes>
            <class name="com.erp.tests.functional.storage.CrewWriteOffTest">
                <methods>
                    <include name="testWriteOffAppearsAfterFightSync"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
