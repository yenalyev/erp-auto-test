<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Inventory domain suite — manual TC-WMS-003 / TC-WMS-007 coverage.

  Run:
    mvn test -Denv=dev -Dsuite=inventory
-->
<suite name="Inventory Test Suite" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.erp.listeners.GoogleSheetsReportListener"/>
        <listener class-name="com.erp.listeners.TcmScopeListener"/>
        <listener class-name="com.erp.listeners.TcmReportListener"/>
        <listener class-name="com.erp.listeners.RunProgressListener"/>
        <listener class-name="com.erp.listeners.TestCaseIdListener"/>
    </listeners>

    <test name="Inventory API">
        <classes>
            <class name="com.erp.tests.functional.inventory.InventorySessionApiTest"/>
            <class name="com.erp.tests.functional.inventory.InventoryConductApiTest"/>
            <class name="com.erp.tests.functional.inventory.InventoryStockApiTest"/>
            <class name="com.erp.tests.functional.inventory.StorageRelationInventoryTest"/>
            <class name="com.erp.tests.functional.storage.CrewInventoryTest"/>
            <class name="com.erp.tests.functional.storage.FlyPointInventoryTest"/>
            <class name="com.erp.tests.functional.storage.CrewFlyPointInventoryTest"/>
            <class name="com.erp.tests.functional.inventory.InventoryHierarchyApiTest"/>
        </classes>
    </test>

    <test name="Inventory UI">
        <classes>
            <class name="com.erp.tests.ui.InventoryUiTest"/>
            <class name="com.erp.tests.ui.InventoryHierarchyUiTest"/>
            <class name="com.erp.tests.ui.CrewResourceVisibilityUiTest"/>
            <class name="com.erp.tests.ui.CrewFlyPointInventoryUiTest"/>
        </classes>
    </test>
</suite>
